[run]
source = src/pyaermod
omit =
    # pywebview native window + real server thread; everything else in
    # gui_v2 is exercised headlessly by tests/test_gui_v2_smoke.py.
    src/pyaermod/gui_v2/desktop.py
    */__main__.py

[report]
show_missing = true
precision = 1
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    if HAS_
    except ImportError

[html]
directory = htmlcov
